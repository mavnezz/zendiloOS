{
  "openapi": "3.1.0",
  "info": {
    "title": "Zendiloos API",
    "description": "Management API of the Zendiloos NAS operating system.",
    "license": {
      "name": "Apache-2.0",
      "identifier": "Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Signs in with name and password.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; the session cookie is set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "401": {
            "description": "`invalid_credentials`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "`account_disabled`, `csrf_rejected`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Ends the current session.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out; the session cookie is removed."
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/auth/password": {
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Changes the caller's password and ends their other sessions.",
        "operationId": "change_password",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Changed."
          },
          "422": {
            "description": "`wrong_password`, `invalid_input`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "The signed-in account and the CSRF token of this session.",
        "operationId": "session",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness check for monitoring and the reverse proxy.",
        "description": "Public, so it deliberately reveals nothing about the system, not even the\nsoftware version.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/setup": {
      "get": {
        "tags": [
          "identity"
        ],
        "summary": "Whether the initial setup is still pending.",
        "operationId": "setup_status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "identity"
        ],
        "summary": "Creates the first administrator and signs them in.",
        "operationId": "complete_setup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Signed in; the session cookie is set.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionInfo"
                }
              }
            }
          },
          "409": {
            "description": "`setup_completed`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "`invalid_setup_code`, `invalid_input`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "`too_many_attempts`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/info": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Facts about the host and the installed Zendiloos version.",
        "operationId": "info",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemInfo"
                }
              }
            }
          },
          "401": {
            "description": "`unauthenticated`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    },
    "/api/v1/system/power": {
      "post": {
        "tags": [
          "system"
        ],
        "summary": "Reboots or powers off the system. Needs `system.manage`.",
        "operationId": "power",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PowerRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "The action is under way."
          },
          "403": {
            "description": "`forbidden`, `csrf_rejected`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "session": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AccountRole": {
        "type": "string",
        "enum": [
          "admin",
          "user",
          "readonly"
        ]
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": [
          "current_password",
          "new_password"
        ],
        "properties": {
          "current_password": {
            "type": "string",
            "format": "password"
          },
          "new_password": {
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      },
      "CurrentAccount": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "permissions",
          "password_change_required"
        ],
        "properties": {
          "full_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "password_change_required": {
            "type": "boolean",
            "description": "Nothing but changing the password is allowed until this is false."
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Everything this account may do, e.g. `system.view`. The interface\nuses it to show only what is allowed; the server checks anyway."
          },
          "role": {
            "$ref": "#/components/schemas/AccountRole"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "`ok` whenever the server answers."
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "name",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "password": {
            "type": "string",
            "format": "password"
          }
        },
        "additionalProperties": false
      },
      "PowerActionKind": {
        "type": "string",
        "enum": [
          "reboot",
          "power_off"
        ]
      },
      "PowerRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "$ref": "#/components/schemas/PowerActionKind"
          }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "description": "Error body as defined by RFC 9457 (`application/problem+json`).",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, machine-readable identifier the frontend can rely on, e.g. `not_found`."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable explanation, if there is more to say than the title."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Reason phrase of the status code."
          },
          "type": {
            "type": "string",
            "description": "Always `about:blank`; `code` identifies the problem."
          }
        }
      },
      "SessionInfo": {
        "type": "object",
        "required": [
          "account",
          "csrf_token",
          "expires_at"
        ],
        "properties": {
          "account": {
            "$ref": "#/components/schemas/CurrentAccount"
          },
          "csrf_token": {
            "type": "string",
            "description": "Send in the `X-CSRF-Token` header with every request that changes\nsomething."
          },
          "expires_at": {
            "type": "integer",
            "format": "int64",
            "description": "When the session ends at the latest, as Unix time in seconds."
          }
        }
      },
      "SetupRequest": {
        "type": "object",
        "required": [
          "setup_code",
          "name",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Name of the first administrator account."
          },
          "password": {
            "type": "string",
            "format": "password"
          },
          "setup_code": {
            "type": "string",
            "format": "password",
            "description": "The code shown on the system's console, e.g. `ABCD-EFGH-JKLM`."
          }
        },
        "additionalProperties": false
      },
      "SetupStatus": {
        "type": "object",
        "required": [
          "required"
        ],
        "properties": {
          "required": {
            "type": "boolean",
            "description": "No administrator exists yet; the interface must offer the setup."
          }
        }
      },
      "SystemInfo": {
        "type": "object",
        "required": [
          "hostname",
          "kernel_release",
          "architecture",
          "cpu_threads",
          "memory_total_bytes",
          "uptime_seconds",
          "version"
        ],
        "properties": {
          "architecture": {
            "type": "string",
            "description": "Machine architecture, e.g. `x86_64`."
          },
          "cpu_model": {
            "type": [
              "string",
              "null"
            ]
          },
          "cpu_threads": {
            "type": "integer",
            "description": "Logical CPUs (hardware threads).",
            "minimum": 0
          },
          "hostname": {
            "type": "string"
          },
          "kernel_release": {
            "type": "string"
          },
          "memory_total_bytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "os_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Operating system, e.g. `Debian GNU/Linux 13 (trixie)`."
          },
          "uptime_seconds": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "version": {
            "type": "string",
            "description": "Version of Zendiloos."
          }
        }
      }
    },
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-zendiloos_session",
        "description": "Set by login or setup. Named `zendiloos_session` where secure cookies are off."
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Health and information about the host"
    },
    {
      "name": "identity",
      "description": "Initial setup, login and sessions"
    }
  ]
}
