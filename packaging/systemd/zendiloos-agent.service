[Unit]
Description=zendiloOS privileged agent
Documentation=https://github.com/mavnezz/zendiloOS
Requires=zendiloos-agent.socket
After=zendiloos-agent.socket

# Started on demand through zendiloos-agent.socket; no [Install] section.
[Service]
# Operations under way are seen through when it is asked to stop: only
# the agent is told to (mixed), not the programs it runs for them, which
# systemd would otherwise stop at once; what is left at the end is killed.
TimeoutStopSec=2h
KillMode=mixed
ExecStart=/usr/libexec/zendiloos/zendiloos-agent

# Root, but with only what the operations need; each new operation widens
# this deliberately:
# - reboot and power off go through systemd and need nothing;
# - SMART reads disks through SG_IO (CAP_SYS_RAWIO) and NVMe admin
#   commands (CAP_SYS_ADMIN); an eMMC device's wear is read from the files
#   of its card in /sys, which needs nothing;
# - where each disk sits: udev's database (udevadm info, /run/udev) and
#   DMI's names in /sys are read; a disk made to blink is read from with
#   O_DIRECT, never written, which the device rules below allow already;
# - pools: partitioning and ZFS write to disks and /dev/zfs, re-read
#   partition tables and use ZFS ioctls (CAP_SYS_ADMIN); mount units go to
#   /etc/systemd/system and are mounted by systemd, outside this sandbox;
#   the ZFS module rewrites /etc/zfs/zpool.cache in the mount namespace of
#   the zpool that asks it to;
# - users and groups: the shadow tools change the account databases
#   directly in /etc, in transient units (systemd-run) that may write /etc
#   with CAP_CHOWN alone (which gives /etc/shadow its group), see their
#   sandbox in etc_units.rs; smbpasswd writes Samba's databases here;
# - shares: datasets and mount units as for pools; Samba's configuration
#   in /etc/samba, NFS's in /etc/exports.d, NFS state in /var/lib/nfs;
#   smbd, wsdd2 and nfs-server are started, stopped, enabled and disabled
#   by systemd; smbcontrol makes every smbd read the configuration again
#   and ends the connections of a share someone lost access to (Samba's
#   messages, in /run/samba and /var/lib/samba);
# - personal folders: their dataset and mount unit as for shares, and
#   each user's quota (zfs userquota); the folders themselves are the files
#   agent's;
# - time: systemd-timedated sets the zone, network time and the clock
#   (asked over D-Bus by timedatectl; the agent itself may not touch the
#   clock), timesyncd's server list goes to /etc/systemd/timesyncd.conf.d;
# - the machine's name: systemd-hostnamed sets it (asked over D-Bus by
#   hostnamectl; the agent's own UTS namespace below keeps the name it
#   started with); /etc/hosts is replaced by a transient unit (this binary
#   as put-etc-file, with no capability), the machine's own certificate
#   goes to /etc/zendiloos/tls (openssl); Avahi, smbd and wsdd2, which
#   read the name when they start, are restarted by systemd;
# - the configuration backup: its files are read where they are; restored,
#   the certificates go to /etc/zendiloos (nginx -t and a reload, as for
#   issued ones), Samba's passwords to /var/lib/samba/private (smbd
#   stopped meanwhile), ZFS's host id to /etc/hostid (put-etc-file, as
#   /etc/hosts); the people's users and groups are made with the IDs they
#   had by the shadow tools, as above;
# - SSH: its settings go to /etc/ssh/sshd_config.d; `sshd -t` checks them
#   in a transient unit (systemd-run), which brings /run/sshd along when
#   the service is stopped; ssh.service is started, stopped, enabled and
#   disabled by systemd, and a transient timer turns it off on request;
# - the web interface's oldest TLS version goes to /etc/zendiloos/nginx,
#   and nginx is reloaded by systemd;
# - apps: Docker's data and each app's on datasets as for shares (its data
#   root in /etc/docker/daemon.json, a drop-in in /etc/systemd/system), the
#   apps' accounts as for people, their checked compose files in
#   /etc/zendiloos/apps; `docker compose` talks to dockerd over its socket
#   (AF_UNIX), and dockerd, outside this sandbox, fetches and runs. Before
#   every start the agent walks the folders an app mounts, which belong to
#   the app's account (CAP_DAC_READ_SEARCH). Folders in shares an app was
#   given are mounted by a unit per app (zendiloos-app-<app>-shares.service,
#   this binary as `pin-shares`) in the host's namespace, as mount units are;
#   a terminal in a container is `docker exec` on a pseudo terminal
#   (/dev/ptmx and /dev/pts, which DevicePolicy=closed allows) whose master
#   goes to zendiloosd, started through setsid as the leader of its own
#   session;
# - Debian's packages, Docker's among them, and zendiloOS's releases: apt
#   runs outside this sandbox in a transient unit (systemd-run,
#   zendiloos-packages.service, this binary as `run-packages`), which
#   records its steps in /var/lib/zendiloos-packages and sets which kernel
#   GRUB starts (grub-editenv in /boot, as the package's kernel hooks do);
#   the agent only reads that and, before an update, the release zendiloosd
#   downloaded.
# - removable drives: mounted by systemd in transient mount units
#   (systemd-mount) below /run/zendiloos-removable, unmounted, their
#   places removed and their disks powered off in transient services
#   (systemd-run: umount, rmdir, this binary as `power-off-drive`, which
#   writes to sysfs), all outside this sandbox, which only sees them;
#   /run stays read-only here, so no mount of its own hides theirs.
# - the network: an interface's settings, and the bridges, bonds and VLANs
#   zendiloOS makes, go to /etc/systemd/network, which systemd-networkd
#   reads again when asked over D-Bus (busctl); it makes new devices but
#   never removes one, so the link of a device that goes is deleted in a
#   transient unit (systemd-run, `ip link delete` with CAP_NET_ADMIN alone),
#   in the host's network namespace; zendiloos-docker-bridges.service
#   (this binary as `docker-bridges`) lets frames within zendiloOS's
#   bridges pass Docker's FORWARD chain;
#   taking it over from ifupdown changes /etc/network/interfaces (a record
#   of what it changes in /etc/network) and /etc/resolv.conf (put-etc-file,
#   as /etc/hosts) and has systemd stop networking.service and start
#   systemd-networkd and systemd-resolved, outside this sandbox;
# - the firewall: its rules go to /etc/zendiloos/firewall, are checked
#   with `nft -c` in a transient unit and loaded by
#   zendiloos-firewall.service, both in the host's network namespace,
#   outside this sandbox (which has a network of its own);
# - Docker's volumes: listed, made and removed with `docker`; their data
#   counted in Docker's data root (CAP_DAC_READ_SEARCH); backed up into a
#   share and restored by transient units (systemd-run, this binary as
#   backup-volume, restore-volume or remove-volume-backup), outside this
#   sandbox, each in a sandbox of its own that may write only the share or
#   the volume's folder, may not connect() at all, sees an empty /run (no
#   control socket of the machine), none of the system's secrets and only
#   its own processes (PrivatePIDs), and is stopped with SIGKILL, as its
#   first process takes no signal it has no handler for yet; a
#   backup's manifest is signed with a key of this agent's in
#   /etc/zendiloos/volume-backup-keys, made at the first backup and handed
#   to the unit on its standard input;
# - the backup plugin: its runs, listings, retention and restores in
#   transient units (this binary as backup-unit; rsync, ssh, rclone) whose
#   view of the system is an allow-list (/usr, their own processes in
#   /proc, their own /dev and /tmp, of /etc what the tools read, the roots
#   they work on; not /sys's firmware, serial numbers or kernel, nothing
#   mounted after they started), with their
#   own processes only; stopped with SIGTERM, which rsync and rclone get
#   too, and killed after ten seconds; the NAS's SSH key is read here and
#   handed to the unit on its standard input;
# - virtual machines: libvirt's daemon, outside this sandbox, runs QEMU
#   and passt; the agent talks to it with virsh over its socket (AF_UNIX)
#   and keeps each domain's XML in /etc/zendiloos/vms; a VM's disks are
#   zvols (/dev/zfs, as for pools), made, grown and destroyed with zfs;
#   /dev/kvm, /proc/cpuinfo and /sys are only looked at, and whether a
#   VM's bridge is a bridge of the host's is asked of systemd-networkd over
#   D-Bus (busctl), as this sandbox sees none of the host's links. The
#   image library's ISOs are copied from a share, received from an upload
#   through a pipe whose writing end goes to zendiloosd, and removed again,
#   by transient units (systemd-run, this binary as copy-vm-iso and
#   receive-vm-image, and rm) that may write only the VMs' folder, the
#   receiving one with no capability at all; the free space for an upload
#   is looked at (statvfs) and its folder listed, read only. The
#   consoles' folder is made by systemd-tmpfiles in one, from
#   /etc/tmpfiles.d, and AppArmor lets QEMU reach it by rules in
#   /etc/apparmor.d/abstractions/libvirt-qemu.d. A console is
#   QEMU's VNC socket in /run/zendiloos-vms, opened without following a
#   link and connected to (connecting needs no write access to /run), and
#   handed to zendiloosd like a terminal's master. The host's USB and PCI
#   devices a VM may be given are read from /sys (and the PCI ID
#   database), which network cards the host uses is asked of
#   systemd-networkd (busctl), and a disk in use below a controller is
#   found as when erasing disks (holders, mountinfo, swaps, an O_EXCL
#   open, which a disk of a kind this sandbox may not open, as eMMC,
#   fails: in use); libvirt binds a PCI device to vfio-pci, outside this
#   sandbox. libvirt's own autostart stays off: VMs that start with the
#   machine are started by the agent, once a boot (its boot id recorded in
#   the state directory), with the checks of any start. What a VM's cards
#   through passt reach (QEMU's account's traffic) is held by nftables
#   rules in /etc/zendiloos/network, loaded by
#   zendiloos-passt.service outside this sandbox.
#   Snapshots of a VM's disks are taken with zfs; a VM's backups and
#   restores run in transient units (this binary as back-up-vm,
#   restore-vm and remove-vm-backup) that may open the VM's own zvols'
#   devices alone (DeviceAllow=/dev/zdN), read only for a backup, and
#   write only the share or drive, or libvirt's folders of the UEFI
#   variables and TPM states, with the volumes' units' empty /run and own
#   processes. The template of the UEFI variables with Microsoft's
#   certificates of 2023 is made by virt-fw-vars in the state directory
#   (/var/lib/zendiloos-agent), and described to QEMU's firmware selection
#   in /etc/qemu/firmware;
# - a UPS: Network UPS Tools' files go to /etc/nut, with the group of that
#   folder (CAP_CHOWN), which NUT's programs run in; its driver, server and
#   monitor are enabled, started and stopped by systemd, outside this
#   sandbox, and it is NUT's monitor there, not the agent, that shuts the
#   machine down. UPSs on USB are looked for (nut-scanner) in a transient
#   unit: this sandbox has no USB devices; that unit has those alone, an
#   allow-list of the file system as the backup units have, no
#   capabilities, no IP network and no connect();
# The contents of volumes are the files agent's (zendiloos-files.service).
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_READ_SEARCH
PrivateNetwork=yes
# Of /etc only the folders named here may be written, never /etc itself:
# what lies directly in it (the account databases, /etc/hosts,
# /etc/hostid, /etc/resolv.conf) is replaced by renaming and changed in the
# transient units above, which may write /etc and do nothing else. A
# folder must be there when the agent starts, or it stays read-only here
# until the next start. Those no package zendiloOS depends on brings, and
# those of plugins installed later (Docker, NUT, libvirt and QEMU), the
# package makes, as Debian's packages make them (zendiloos.tmpfiles, at
# its installation and every boot): a plugin's package finds its folder
# there and gives it the owner and mode it wants, as for one it made
# itself. "-": the agent starts without the folder, whose operations then
# fail. tests/units.rs holds this list, the places the agent writes and
# the folders the package makes together.
ProtectSystem=strict
ReadWritePaths=/etc/zendiloos /etc/systemd/system /etc/systemd/network /etc/samba /etc/zfs /etc/tmpfiles.d
ReadWritePaths=-/etc/systemd/timesyncd.conf.d -/etc/ssh/sshd_config.d -/etc/exports.d -/etc/docker -/etc/nut
ReadWritePaths=-/etc/network -/etc/apparmor.d/abstractions/libvirt-qemu.d -/etc/qemu/firmware
ReadWritePaths=-/var/lib/samba -/var/cache/samba -/run/samba -/var/lib/nfs -/run/issue.d -/run/zendiloos-acme
StateDirectory=zendiloos-agent
ProtectHome=yes
PrivateTmp=yes
# Disks (SATA/SAS/USB, NVMe namespaces, virtio) and ZFS; nothing else.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=block-sd rw
DeviceAllow=block-blkext rw
DeviceAllow=block-virtblk rw
DeviceAllow=char-nvme r
DeviceAllow=/dev/zfs rw
# Optical drives and SD/eMMC cards, read only: the exclusive open that
# tells whether one is in use before its USB device or controller goes to
# a VM (empty: no medium; mounted or claimed: busy). Denied, it would
# count as in use.
DeviceAllow=block-sr r
DeviceAllow=block-mmc r
# What it runs (Docker Compose, zfs, apt's checks) needs little; a
# Compose file that reads without end (in a share, a link to a device or a
# pipe) must not take the machine's memory.
MemoryHigh=768M
MemoryMax=1G
# Copies and walks hold a descriptor or two per level of a tree; counting
# volumes holds one or two in all. systemd's soft limit of 1024 would run
# out under a few deep trees at once.
LimitNOFILE=65536
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
