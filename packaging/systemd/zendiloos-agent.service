[Unit]
Description=zendiloOS privileged agent
Documentation=https://github.com/mavnezz/zendiloOS
Requires=zendiloos-agent.socket
After=zendiloos-agent.socket

# Started on demand through zendiloos-agent.socket; no [Install] section.
[Service]
# Operations under way are seen through when it is asked to stop: only
# the agent is told to (mixed), not the programs it runs for them, which
# systemd would otherwise stop at once; what is left at the end is killed.
TimeoutStopSec=2h
KillMode=mixed
ExecStart=/usr/libexec/zendiloos/zendiloos-agent

# Root, but with only what the operations need; each new operation widens
# this deliberately:
# - reboot and power off go through systemd and need nothing;
# - SMART reads disks through SG_IO (CAP_SYS_RAWIO) and NVMe admin
#   commands (CAP_SYS_ADMIN); an eMMC device's wear is read from the files
#   of its card in /sys, which needs nothing;
# - where each disk sits: udev's database (udevadm info, /run/udev) and
#   DMI's names in /sys are read; a disk made to blink is read from with
#   O_DIRECT, never written, which the device rules below allow already;
# - pools: partitioning and ZFS write to disks and /dev/zfs, re-read
#   partition tables and use ZFS ioctls (CAP_SYS_ADMIN); mount units go to
#   /etc/systemd/system and are mounted by systemd, outside this sandbox;
# - the shadow tools and smbpasswd write /etc and Samba's databases and
#   set the group of /etc/shadow (CAP_CHOWN);
# - shares: datasets and mount units as for pools; Samba and NFS
#   configuration in /etc, NFS state in /var/lib/nfs; smbd, wsdd2 and
#   nfs-server are started, stopped, enabled and disabled by systemd;
#   smbcontrol makes every smbd read the configuration again and ends the
#   connections of a share someone lost access to (Samba's messages, in
#   /run/samba and /var/lib/samba);
# - personal folders: their dataset and mount unit as for shares, and
#   each user's quota (zfs userquota); the folders themselves are the files
#   agent's;
# - time: systemd-timedated sets the zone, network time and the clock
#   (asked over D-Bus by timedatectl; the agent itself may not touch the
#   clock), timesyncd's server list goes to /etc;
# - the machine's name: systemd-hostnamed sets it (asked over D-Bus by
#   hostnamectl; the agent's own UTS namespace below keeps the name it
#   started with), /etc/hosts and the machine's own certificate in
#   /etc/zendiloos/tls (openssl) are in /etc; Avahi, smbd and wsdd2, which
#   read the name when they start, are restarted by systemd;
# - SSH: its settings go to /etc/ssh/sshd_config.d; `sshd -t` checks them
#   in a transient unit (systemd-run), which brings /run/sshd along when
#   the service is stopped; ssh.service is started, stopped, enabled and
#   disabled by systemd, and a transient timer turns it off on request;
# - the web interface's oldest TLS version goes to /etc/zendiloos/nginx,
#   and nginx is reloaded by systemd;
# - apps: Docker's data and each app's on datasets as for shares, the
#   apps' accounts as for people, their checked compose files in
#   /etc/zendiloos/apps; `docker compose` talks to dockerd over its socket
#   (AF_UNIX), and dockerd, outside this sandbox, fetches and runs. Before
#   every start the agent walks the folders an app mounts, which belong to
#   the app's account (CAP_DAC_READ_SEARCH). Folders in shares an app was
#   given are mounted by a unit per app (zendiloos-app-<app>-shares.service,
#   this binary as `pin-shares`) in the host's namespace, as mount units are;
#   a terminal in a container is `docker exec` on a pseudo terminal
#   (/dev/ptmx and /dev/pts, which DevicePolicy=closed allows) whose master
#   goes to zendiloosd, started through setsid as the leader of its own
#   session;
# - Debian's packages, Docker's among them, and zendiloOS's releases: apt
#   runs outside this sandbox in a transient unit (systemd-run,
#   zendiloos-packages.service, this binary as `run-packages`), which
#   records its steps in /var/lib/zendiloos-packages and sets which kernel
#   GRUB starts (grub-editenv in /boot, as the package's kernel hooks do);
#   the agent only reads that and, before an update, the release zendiloosd
#   downloaded.
# - removable drives: mounted by systemd in transient mount units
#   (systemd-mount) below /run/zendiloos-removable, unmounted, their
#   places removed and their disks powered off in transient services
#   (systemd-run: umount, rmdir, this binary as `power-off-drive`, which
#   writes to sysfs), all outside this sandbox, which only sees them;
#   /run stays read-only here, so no mount of its own hides theirs.
# - the network: an interface's settings, and the bridges, bonds and VLANs
#   zendiloOS makes, go to /etc/systemd/network, which systemd-networkd
#   reads again when asked over D-Bus (busctl); it makes new devices but
#   never removes one, so the link of a device that goes is deleted in a
#   transient unit (systemd-run, `ip link delete` with CAP_NET_ADMIN alone),
#   in the host's network namespace; zendiloos-docker-bridges.service
#   (this binary as `docker-bridges`) lets frames within zendiloOS's
#   bridges pass Docker's FORWARD chain;
#   taking it over from ifupdown changes /etc/network/interfaces and
#   /etc/resolv.conf (a record of them in /etc/network) and has systemd
#   stop networking.service and start systemd-networkd and
#   systemd-resolved: the files are in /etc, the services run outside
#   this sandbox;
# - the firewall: its rules go to /etc/zendiloos/firewall, are checked
#   with `nft -c` in a transient unit and loaded by
#   zendiloos-firewall.service, both in the host's network namespace,
#   outside this sandbox (which has a network of its own);
# - Docker's volumes: listed, made and removed with `docker`; their data
#   counted in Docker's data root (CAP_DAC_READ_SEARCH); backed up into a
#   share and restored by transient units (systemd-run, this binary as
#   backup-volume, restore-volume or remove-volume-backup), outside this
#   sandbox, each in a sandbox of its own that may write only the share or
#   the volume's folder;
# - virtual machines: libvirt's daemon, outside this sandbox, runs QEMU
#   and passt; the agent talks to it with virsh over its socket (AF_UNIX)
#   and keeps each domain's XML in /etc/zendiloos/vms; a VM's disks are
#   zvols (/dev/zfs, as for pools), made, grown and destroyed with zfs;
#   /dev/kvm, /proc/cpuinfo and /sys are only looked at, and whether a
#   VM's bridge is a bridge of the host's is asked of systemd-networkd over
#   D-Bus (busctl), as this sandbox sees none of the host's links. The
#   image library's ISOs are copied from a share, received from an upload
#   through a pipe whose writing end goes to zendiloosd, and removed again,
#   by transient units (systemd-run, this binary as copy-vm-iso and
#   receive-vm-image, and rm) that may write only the VMs' folder, the
#   receiving one with no capability at all; the free space for an upload
#   is looked at (statvfs) and its folder listed, read only. The
#   consoles' folder is made by systemd-tmpfiles in one. A console is
#   QEMU's VNC socket in /run/zendiloos-vms, opened without following a
#   link and connected to (connecting needs no write access to /run), and
#   handed to zendiloosd like a terminal's master;
# The contents of volumes are the files agent's (zendiloos-files.service).
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_SYS_RAWIO CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_READ_SEARCH
PrivateNetwork=yes
ProtectSystem=strict
ReadWritePaths=/etc -/var/lib/samba -/var/cache/samba -/run/samba -/var/lib/nfs -/run/issue.d -/run/zendiloos-acme
ProtectHome=yes
PrivateTmp=yes
# Disks (SATA/SAS/USB, NVMe namespaces, virtio) and ZFS; nothing else.
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=block-sd rw
DeviceAllow=block-blkext rw
DeviceAllow=block-virtblk rw
DeviceAllow=char-nvme r
DeviceAllow=/dev/zfs rw
# What it runs (Docker Compose, zfs, apt's checks) needs little; a
# Compose file that reads without end (in a share, a link to a device or a
# pipe) must not take the machine's memory.
MemoryHigh=768M
MemoryMax=1G
# Copies and walks hold a descriptor or two per level of a tree; counting
# volumes holds one or two in all. systemd's soft limit of 1024 would run
# out under a few deep trees at once.
LimitNOFILE=65536
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
