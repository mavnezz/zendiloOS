[Unit]
Description=zendiloOS self-signed TLS certificate
Documentation=https://github.com/mavnezz/zendiloOS
# Unless both are there: a run interrupted halfway is made good.
ConditionFileNotEmpty=|!/etc/zendiloos/tls/zendiloos.key
ConditionFileNotEmpty=|!/etc/zendiloos/tls/zendiloos.crt
Before=nginx.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/zendiloos/make-certificate

[Install]
WantedBy=multi-user.target
