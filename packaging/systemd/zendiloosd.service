[Unit]
Description=zendiloOS management service
Documentation=https://github.com/mavnezz/zendiloOS
Requires=zendiloosd.socket
Wants=zendiloos-agent.socket
After=zendiloosd.socket zendiloos-agent.socket network.target
# The console login prompt shows the setup code written during startup.
Before=getty.target

[Service]
Type=notify
ExecStart=/usr/sbin/zendiloosd serve
User=zendiloos
Group=zendiloos
# Reads the journal for the log viewer, with journalctl.
SupplementaryGroups=systemd-journal
StateDirectory=zendiloos
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2

# An unprivileged, network-facing service: no capabilities, no devices,
# a read-only system except its state directory.
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
# Netlink: `ip` reads the network for the interface (reading needs no
# capability).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
# `ip` drops its capabilities with capset when it starts, though it has
# none; without this, seccomp kills it.
SystemCallFilter=capset

[Install]
WantedBy=multi-user.target
