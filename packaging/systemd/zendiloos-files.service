[Unit]
Description=zendiloOS files agent
Documentation=https://github.com/mavnezz/zendiloOS
Requires=zendiloos-files.socket
After=zendiloos-files.socket

# Started on demand through zendiloos-files.socket; no [Install] section.
[Service]
# Operations under way are seen through when it is asked to stop.
TimeoutStopSec=2h
ExecStart=/usr/libexec/zendiloos/zendiloos-agent --role files

# The same program as zendiloos-agent, serving only requests about the
# contents of volumes: share permissions and the file manager. It
# may write below /volume<N> and act as a user, but touches no disk, no
# system configuration and no network:
# - share permissions: owner and ACLs of files owned by users (CAP_CHOWN,
#   CAP_FOWNER), reaching them in users' private directories
#   (CAP_DAC_READ_SEARCH);
# - the file manager: opening files as the signed-in user (CAP_SETUID,
#   CAP_SETGID);
# - personal folders: making each user's folder in /volume<N>/@homes and
#   giving it to the user (CAP_CHOWN).
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID
PrivateNetwork=yes
# /usr, /boot and /etc read-only; volumes live directly below /.
ProtectSystem=full
ProtectHome=yes
# /run too: its socket comes as a descriptor, and nothing there is its business.
ReadOnlyPaths=/var /run -/srv -/opt -/mnt -/media
InaccessiblePaths=-/var/lib/zendiloos -/var/lib/samba -/etc/zendiloos -/etc/ssh -/etc/shadow -/etc/gshadow
PrivateTmp=yes
PrivateDevices=yes
# It streams; a request that would need more memory than this is broken
# or hostile, and must not push smbd or zendiloosd out.
MemoryHigh=384M
MemoryMax=512M
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
# Not RestrictSUIDSGID: to enforce it, systemd blocks openat2(), whose
# arguments seccomp cannot inspect, and openat2() is what keeps paths
# inside a share. Volumes are mounted with setuid=off and devices=off
# instead, which holds for Samba and NFS too.
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
