#!/bin/sh
set -e

# The appliance owns nginx: retire the stock default site, which would
# claim the same ports. Only the untouched stock link is removed.
retire_default_site() {
    link=/etc/nginx/sites-enabled/default
    if [ -L "$link" ] && [ "$(readlink "$link")" = /etc/nginx/sites-available/default ]; then
        rm "$link"
    fi
}

# Samba: zendiloOS writes its shares to /etc/samba/zendiloos.conf. On a
# system whose smb.conf is still Debian's original, it takes over smb.conf
# (no [homes], no printers, no guests); a changed smb.conf is left alone.
configure_samba() {
    ours=/etc/samba/zendiloos.conf
    if [ ! -e "$ours" ]; then
        printf '# Written by zendiloOS. Changes here are overwritten; use the web interface.\n' > "$ours"
    fi
    if [ -f /usr/share/samba/smb.conf ] && cmp -s /etc/samba/smb.conf /usr/share/samba/smb.conf; then
        cp -p /etc/samba/smb.conf /etc/samba/smb.conf.debian
        cp /usr/share/zendiloos/smb.conf /etc/samba/smb.conf
        deb-systemd-invoke try-reload-or-restart smbd.service || true
    elif ! grep -qs '^[[:space:]]*include[[:space:]]*=[[:space:]]*/etc/samba/zendiloos.conf' /etc/samba/smb.conf; then
        echo "zendiloos: add 'include = /etc/samba/zendiloos.conf' to /etc/samba/smb.conf to offer its shares" >&2
    fi
}

# ZFS: on a first installation zfs-dkms builds the module only after
# zfsutils-linux tried to load it, so it is not loaded until the next boot,
# and the agent may not load modules. Load it now, so pools can be created
# right away.
load_zfs() {
    if [ ! -d /sys/module/zfs ] && ! modprobe zfs 2>/dev/null; then
        echo "zendiloos: the ZFS module could not be loaded; pools need a reboot or 'modprobe zfs'" >&2
    fi
}

# The web interface's oldest TLS version, which the control panel rewrites;
# nginx's site includes it.
web_tls_defaults() {
    if [ ! -e /etc/zendiloos/nginx/tls.conf ]; then
        mkdir -p /etc/zendiloos/nginx
        printf '%s\n' '# Written by zendiloOS; changes made here are replaced.' \
            'ssl_protocols TLSv1.2 TLSv1.3;' >/etc/zendiloos/nginx/tls.conf
    fi
}

# The web interface's ports and certificate, which the control panel
# rewrites; nginx's site includes both files. Until then: plain HTTP on 80
# pointing to HTTPS on 443, with the machine's own certificate.
web_server_defaults() {
    mkdir -p /etc/zendiloos/web
    if [ ! -e /etc/zendiloos/web/http.conf ]; then
        cat >/etc/zendiloos/web/http.conf <<'EOF'
# Written by zendiloOS; changes made here are replaced. Change it in the web interface.
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_tokens off;

    # Let's Encrypt's HTTP challenges, answered with what acme.sh wrote.
    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/zendiloos-acme/webroot;
        default_type text/plain;
        try_files $uri =404;
    }

    # Everything else to HTTPS: the session cookie is HTTPS-only.
    location / {
        return 301 https://$host$request_uri;
    }
}
EOF
    fi
    if [ ! -e /etc/zendiloos/web/https.conf ]; then
        cat >/etc/zendiloos/web/https.conf <<'EOF'
# Written by zendiloOS; changes made here are replaced. Change it in the web interface.
listen 443 ssl default_server;
listen [::]:443 ssl default_server;
ssl_certificate     /etc/zendiloos/tls/zendiloos.crt;
ssl_certificate_key /etc/zendiloos/tls/zendiloos.key;
EOF
    fi
}

# Access to a share is the share's as a whole after 0.2.0: the files of
# shares made before keep entries per person until zendiloosd has walked
# them, once, one share after another, as jobs (docs/architecture.md, 4.4).
# Samba and the file manager hold the rules meanwhile; NFS clients and apps
# reach what a walk got to. The group zendiloos-files comes from sysusers.
announce_share_walks() {
    if [ -n "$1" ] && dpkg --compare-versions "$1" lt 0.2.1~; then
        echo "zendiloos: the shares' files are given share-level access in the background, one share at a time (see the jobs)" >&2
    fi
}

# systemd-gpt-auto-generator mounts partitions of the discoverable GPT
# types that fstab does not name. A NAS installed with Debian's installer
# names all of its own in fstab, and zendiloOS mounts its pools with units
# of its own; on an eMMC system disk the generator fails at every reload of
# systemd ("Cannot dissect image: Input/output error"), which buries real
# warnings. It is masked, unless something is in its place already (the
# administrator's, or a package's: Ubuntu's systemd ships this very link);
# the marker beside zendiloOS's settings says that the mask is zendiloOS's,
# for the purge.
gpt_auto=/etc/systemd/system-generators/systemd-gpt-auto-generator
mask_gpt_auto() {
    if [ ! -e "$gpt_auto" ] && [ ! -L "$gpt_auto" ]; then
        mkdir -p /etc/systemd/system-generators
        ln -s /dev/null "$gpt_auto"
        mkdir -p /etc/zendiloos
        echo "$gpt_auto" >/etc/zendiloos/masked-generators
    fi
}

case "$1" in
    configure)
        announce_share_walks "$2"
        mask_gpt_auto
        load_zfs
        # Earlier packages linked the console text to a file zendiloosd wrote.
        if [ -L /run/issue.d/zendiloos.issue ]; then rm -f /run/issue.d/zendiloos.issue; fi
        rm -f /var/lib/zendiloos/console.issue /var/lib/zendiloos/console.tmp
        configure_samba
        /usr/libexec/zendiloos/make-certificate
        web_tls_defaults
        web_server_defaults
        retire_default_site
        if nginx -t >/dev/null 2>&1; then
            deb-systemd-invoke reload nginx.service || true
        else
            echo "zendiloos: the nginx configuration does not pass 'nginx -t'" >&2
        fi
        ;;
esac

#DEBHELPER#

exit 0
