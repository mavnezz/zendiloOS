#!/usr/bin/make -f
# Built inside the container of packaging/build.Dockerfile, which provides
# Rust as pinned in rust-toolchain.toml and Node.js 24; Debian 13's own
# toolchains are too old. Hence no Build-Depends on cargo or nodejs.

export DH_VERBOSE = 1
# The SQL macros check queries against backend/.sqlx; no database needed.
export SQLX_OFFLINE = true
# The version zendiloosd reports and compares releases with
# (zendiloos_kernel::VERSION): the package's own.
export ZENDILOOS_VERSION := $(shell dpkg-parsechangelog -S Version)
# The git repository a development build's notes list the commits of;
# packaging/build-deb.sh builds in a copy without one and names the source.
ZENDILOOS_REPOSITORY ?= .

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	cd backend && cargo build --release --locked -p zendiloosd -p zendiloos-agent
	cd frontend && npm ci --no-audit --no-fund && npm run build

# The test suites run with `just check`, not in the package build.
override_dh_auto_test:

override_dh_auto_install:
	install -D -m 0755 backend/target/release/zendiloosd debian/zendiloos/usr/sbin/zendiloosd
	install -D -m 0755 backend/target/release/zendiloos-agent \
		debian/zendiloos/usr/libexec/zendiloos/zendiloos-agent
	install -d debian/zendiloos/usr/share/zendiloos/webui
	cp -r frontend/dist/. debian/zendiloos/usr/share/zendiloos/webui/
	# What changed in this version, which Control panel → Updates shows
	# under the installed version (scripts/release-notes.sh).
	scripts/release-notes.sh "$(ZENDILOOS_VERSION)" debian/changelog "$(ZENDILOOS_REPOSITORY)" \
		> debian/zendiloos/usr/share/zendiloos/changes.md
	# GRUB starts the newest kernel that has its ZFS module: its default is
	# the entry zendiloOS saves, which these hooks set after a kernel or its
	# headers came or a kernel went (docs/architecture.md, 4.10).
	install -D -m 0644 packaging/grub/zendiloos.cfg debian/zendiloos/etc/default/grub.d/zendiloos.cfg
	for hooks in postinst.d postrm.d header_postinst.d; do \
		install -D -m 0755 packaging/kernel/zz-zendiloos debian/zendiloos/etc/kernel/$$hooks/zz-zendiloos; \
	done
	# The key releases are signed with; without it, this build takes no
	# updates of zendiloOS (docs/releases.md).
	if [ -f packaging/release-signing.pub ]; then \
		install -D -m 0644 packaging/release-signing.pub \
			debian/zendiloos/usr/share/zendiloos/release-signing.pub; \
	fi

override_dh_auto_clean:
	rm -rf frontend/dist

# Cargo strips the release binaries already.
override_dh_dwz:
