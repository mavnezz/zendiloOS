#!/bin/sh
set -e

case "$1" in
    remove)
        # Nothing chooses GRUB's kernel any more: it starts the newest
        # again, as Debian's does (the setting stays until a purge, without
        # an entry saved, which GRUB reads as its first).
        if [ -f /boot/grub/grubenv ] && command -v grub-editenv >/dev/null 2>&1; then
            grub-editenv /boot/grub/grubenv unset saved_entry || true
        fi
        # The firewall's rules go with the package; nothing would keep them.
        if command -v nft >/dev/null 2>&1; then
            nft delete table inet zendiloos_firewall 2>/dev/null || true
            # And what keeps the NAS off its internal networks for VMs.
            nft delete table bridge zendiloos_internal 2>/dev/null || true
        fi
        # So does what lets frames within its bridges pass Docker's
        # FORWARD chain: Docker's tables as Docker made them.
        for tables in iptables ip6tables; do
            command -v "$tables" >/dev/null 2>&1 || continue
            while "$tables" -w 10 -t filter -C DOCKER-USER -j ZENDILOOS-BRIDGES 2>/dev/null; do
                "$tables" -w 10 -t filter -D DOCKER-USER -j ZENDILOOS-BRIDGES || break
            done
            "$tables" -w 10 -t filter -F ZENDILOOS-BRIDGES 2>/dev/null || true
            "$tables" -w 10 -t filter -X ZENDILOOS-BRIDGES 2>/dev/null || true
        done
        ;;
    purge)
        # Generated at installation; the database in /var/lib/zendiloos is
        # kept, since it holds the administrators' work.
        rm -rf /etc/zendiloos/tls /etc/zendiloos/nginx /etc/zendiloos/firewall /etc/zendiloos/network
        # The generators the package masked, if they are still masked as it
        # left them; systemd runs them again from the next reload or boot.
        if [ -f /etc/zendiloos/masked-generators ]; then
            while read -r generator; do
                case "$generator" in
                    /etc/systemd/system-generators/*) ;;
                    *) continue ;;
                esac
                if [ -L "$generator" ] && [ "$(readlink "$generator")" = /dev/null ]; then
                    rm -f "$generator"
                fi
            done </etc/zendiloos/masked-generators
            rm -f /etc/zendiloos/masked-generators
            rmdir /etc/systemd/system-generators 2>/dev/null || true
        fi
        ;;
esac

#DEBHELPER#

exit 0
